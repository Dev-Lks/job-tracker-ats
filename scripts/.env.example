# Copie pra scripts/.env e preencha. NUNCA commite o .env (está no .gitignore).
# 1. Fale com @BotFather no Telegram -> /newbot -> ele te dá o token.
# 2. Fale com @userinfobot -> ele te dá seu chat id (só o número).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Adzuna BR (opcional — cobre vagas BR; chave grátis em https://developer.adzuna.com).
# Sem elas o scraper só usa Remotive + Arbeitnow. Também valem como Secrets no Actions.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
